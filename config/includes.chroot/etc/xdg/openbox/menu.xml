<?xml version="1.0" encoding="UTF-8"?>

<openbox_menu xmlns="http://openbox.org/"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://openbox.org/
                file:///usr/share/openbox/menu.xsd">

<menu id="root-menu" label="Openbox 3">
  <separator/>
  <item label="Logout">
	  <action name="Execute"><execute>/usr/bin/bash -c 'killall -9 x2goclient chromium firefox-esr ; rm -rf ~/.config/chromium ~/.mozilla ~/.cache/* ; openbox --exit'</execute></action>
  </item>
  <item label="Reboot">
	  <action name="Execute"><execute>sudo /sbin/reboot</execute></action>
  </item>
  <item label="Shutdown">
	  <action name="Execute"><execute>sudo /sbin/poweroff</execute></action>
  </item>
</menu>

</openbox_menu>
