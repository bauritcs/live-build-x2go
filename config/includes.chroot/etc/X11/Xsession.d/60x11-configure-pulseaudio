# shellcheck shell=dash
# vim: syntax=sh:

# Configure pulseaudio
AUDIOOUT="$(sed -e 's/ \([^ ]*\)=/\n\1=/g' -e 's/\([^=]["'"'"']\) /\1\n/g' -e 's/ \([^ "'"'"']\)/\n\1/g' '/proc/cmdline' | awk -F '=' '/^audioout=/ { print $2 }' | tr -dc 'a-zA-Z0-9.:_\-@|')"

if [ -n "${AUDIOOUT}" ] ; then
	(
		while ! pacmd dump 2>&1| grep -q 'set-card-profile' ; do
			logttycolon 'Waiting for pulseaudio to start ...'
			sleep '1'
		done
		if [ 'list' = "${AUDIOOUT}" ] ; then
			logttycolon 'Available audio outputs:' | tee -a '/tmp/audiolog'
			AUDIOOUTPUTS="$(for CARD in $(pacmd list-cards | grep -A '1' 'index' | awk -F '[<> \t]' ' $2 == "name:" { print $4 }'); do
						pacmd list-cards | more "+/${CARD}" | grep -m '1' "${CARD}" -A '100000' | more '+/profiles:' | grep -m '1' -B '10000' 'active profile:' | \
						grep -A '10000' 'profiles' | grep '\W\Woutput:' | grep -v 'active profile:' | \
						awk -F '[+:]' '{ gsub("\t", "", $1) ; print "\"'"${CARD}"'|" $1 ":" $2 "\"" }';
					done | sort -u)"
			for AUDIOOUTPUT in ${AUDIOOUTPUTS}; do
				logttycolon "$(printf '%s' "${AUDIOOUTPUT}")" | tee -a '/tmp/audiolog'
			done
			logttycolon "$(printf '%s' "$(pacmd list | grep 'active profile')")" | tee -a '/tmp/audiolog'
		elif (echo "${AUDIOOUT}" | grep -q '^[^|]*|[^|]*$') ; then
			eval "$(printf '%s\n' "${AUDIOOUT}" | sed -e 's/^/pacmd set-card-profile /' -e 's/|/ /')"
		else
			: # NOP
		fi
	) &
fi

