# shellcheck shell=dash
# vim: syntax=sh:

# Spawn openbox
if [ -x /usr/bin/openbox ] ; then
        if [ -x /usr/bin/tint2 ] ; then
		logtty 'Not spawning OpenBox - tint2 executable found. (MicroDesktop active?)'
		if ps -C openbox >/dev/null ; then
			openbox --reconfigure
			logtty 'Reconfiguring Openbox.'
		fi
	else
		openbox &
		logtty 'spawned OpenBox.'
	fi
else
	logtty 'Not spawning OpenBox - executable not found. (MiniDesktop active?)'
fi

