# allow xterm if requested

if grep -q '\W*allowxterm\W*' /proc/cmdline && [ -x /usr/bin/xterm ] ; then
	# add entries to tint2 taskbar: a two-step process
	
	# step 1: append config at end of file
	echo -en "\n$(date +'%F | %T | ')'$0' add tint2 executor config entry for /usr/bin/xterm." | tee -a /dev/tty8
	cat >>~/.config/tint2/tint2rc <<NEWXTERMTINT2
#----------------
# Executor for xterm
execp = new
execp_command = echo /usr/share/icons/hicolor/48x48/apps/xterm-color.png
execp_has_icon = 1
execp_interval = 0
execp_centered = 1
execp_font = sans 9
execp_markup = 1
execp_font_color = #aaffaa 100
execp_padding = 2 0
execp_tooltip = XTerm
execp_lclick_command = xterm
execp_background_id = 2

NEWXTERMTINT2
	# step 2: add entry for executor button in panel item sequence
	echo -en "\n$(date +'%F | %T | ')'$0' add tint2 executor button entry for /usr/bin/xterm." | tee -a /dev/tty8
	sed -e 's/^panel_items = L/panel_items = LE/' -i ~/.config/tint2/tint2rc

	# add entries to openbox starter
	echo -en "\n$(date +'%F | %T | ')'$0' add openbox menu entry for /usr/bin/xterm." | tee -a /dev/tty8
	NEWENTRY="  <item label=\"X Terminal\">\n    <action name=\"Execute\"><execute>xterm</execute></action>\n  </item>"
	sed -e "s#<menu id=\"root-menu\" label=\"Openbox 3\">#<menu id=\"root-menu\" label=\"Openbox 3\">\n$NEWENTRY#" -i ~/.config/openbox/menu.xml
	
	# reload config for both openbox and tint2
	if ps -C openbox >/dev/null ; then
		echo -en "\n$(date +'%F | %T | ')'$0' reconfiguring running openbox for $X3270SESSION." | tee -a /dev/tty8
		openbox --reconfigure
	fi
	if ps -C tint2 >/dev/null; then
		echo -en "\n$(date +'%F | %T | ')'$0' reconfiguring running tint2 for $X3270SESSION." | tee -a /dev/tty8
		killall -s SIGUSR1 tint2
	fi

fi

echo -en "\n$(date +'%F | %T | ')'$0' Done." | tee -a /dev/tty8
