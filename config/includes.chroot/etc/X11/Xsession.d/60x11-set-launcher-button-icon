# set custom launcher button icon
LAUNCHICON=$(sed -e 's/ \([^ ]*\)=/\n\1=/g' -e 's/\([^=]["'"'"']\) /\1\n/g' -e 's/ \([^ "'"'"']\)/\n\1/g' /proc/cmdline | awk -F '=' '$1 == "launchicon" { print $2 }' | tr -dc '0-9a-zA-Z,$-_.+!*'"'"'();/?:@=&|')

LAUNCHICONDESTINATION=/etc/x2go/x2golauncher_downloaded.png

if [ -n "$LAUNCHICON" ] ; then

	(
		while ! [ -s "$LAUNCHICONDESTINATION" ] ; do
			echo -en "\n$(date +'%F | %T | ')'$0' Waiting for launcher icon download to finish ..." | tee -a /dev/tty8
			sleep 1
		done
		while ! [ $(ls -i $LAUNCHICONDESTIONATION | awk '{ print $1 }' ) -eq $(ls -i /etc/x2go/x2golauncher.png | awk '{ print $1 }' ) ]; do
			echo -en "\n$(date +'%F | %T | ')'$0' New launcher icon is not in place yet ..." | tee -a /dev/tty8
			sleep 1
		done
		# reload config for tint2
		ps -C tint2 >/dev/null && killall -s SIGUSR1 tint2

	) &
fi

echo -en "\n$(date +'%F | %T | ')'$0' Done." | tee -a /dev/tty8
