# shellcheck shell=dash
# vim: syntax=sh:

. '/lib/live/config/common.logging'

# set custom launcher button icon
LAUNCHICON=$(sed -e 's/ \([^ ]*\)=/\n\1=/g' -e 's/\([^=]["'"'"']\) /\1\n/g' -e 's/ \([^ "'"'"']\)/\n\1/g' /proc/cmdline | awk -F '=' '$1 == "launchicon" { print $2 }' | tr -dc '0-9a-zA-Z,$-_.+!*'"'"'();/?:@=&|')

LAUNCHICONDESTINATION=/etc/x2go/x2golauncher_downloaded.png

if [ -n "$LAUNCHICON" ] ; then

	(
		while ! [ -s "$LAUNCHICONDESTINATION" ] ; do
			logtty 'Waiting for launcher icon download to finish ...'
			sleep 1
		done
		while ! [ "$(stat -c '%i' "${LAUNCHICONDESTINATION}")" -eq "$(stat -c '%i' '/etc/x2go/x2golauncher.png')" ]; do
			logtty 'New launcher icon is not in place yet ...'
			sleep 1
		done
		# reload config for tint2
		ps -C tint2 >/dev/null && killall -s SIGUSR1 tint2

	) &
fi

logtty 'Done.'
