# configure openbox
OPENBOXBUTTONS=$(sed -e 's/ \([^ ]*\)=/\n\1=/g' -e 's/\([^=]["'"'"']\) /\1\n/g' -e 's/ \([^ "'"'"']\)/\n\1/g' /proc/cmdline | awk -F '=' '$1 == "openboxbuttons" { print $2 }' | tr -dc '0-9a-zA-Z,$-_.+!*'"'"'();/?:@=&|' | tr ',' '|')

oldIFS=$IFS
IFS="|"
set -- $OPENBOXBUTTONS
BUTTON1="$1"
BUTTON2="$2"
BUTTON3="$3"
IFS=$oldIFS

mkdir -p ~/.config/openbox/
cp /etc/xdg/openbox/*.xml  ~/.config/openbox/

sed	-e "s/label=\"Logout\"/label=\"$BUTTON1\"/" \
	-e "s/label=\"Reboot\"/label=\"$BUTTON2\"/" \
	-e "s/label=\"Shutdown\"/label=\"$BUTTON3\"/" \
	-i  ~/.config/openbox/menu.xml

# reload config if openbox is already running
ps -C openbox >/dev/null && openbox --reconfigure

echo -en "\n$(date +'%F | %T | ')'$0' Done." | tee -a /dev/tty8
