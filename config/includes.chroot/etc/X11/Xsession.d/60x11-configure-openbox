# shellcheck shell=dash
# vim: syntax=sh:

. '/lib/live/config/common.logging'

# configure openbox
OPENBOXBUTTONS=$(sed -e 's/ \([^ ]*\)=/\n\1=/g' -e 's/\([^=]["'"'"']\) /\1\n/g' -e 's/ \([^ "'"'"']\)/\n\1/g' /proc/cmdline | awk -F '=' '$1 == "openboxbuttons" { print $2 }' | tr -d "'\"|&$"| tr ',' '|')

mkdir -p ~/.config/openbox/
cp /etc/xdg/openbox/*.xml  ~/.config/openbox/

if [ -n "$OPENBOXBUTTONS" ]; then
	oldIFS=$IFS
	IFS="|"
	set -- $OPENBOXBUTTONS
	BUTTON1="$1"
	BUTTON2="$2"
	BUTTON3="$3"
	IFS=$oldIFS
	sed	-e "s/label=\"Logout\"/label=\"$BUTTON1\"/" \
		-e "s/label=\"Reboot\"/label=\"$BUTTON2\"/" \
		-e "s/label=\"Shutdown\"/label=\"$BUTTON3\"/" \
		-i  ~/.config/openbox/menu.xml
fi

# reload config if openbox is already running
ps -C openbox >/dev/null && openbox --reconfigure

logtty 'Done.'
