# shellcheck shell=dash
# vim: syntax=sh:

. '/lib/live/config/common.logging'

# workaround for NX "magic pixel" being active in --thinclient mode
if [ -x /usr/bin/tint2 ] ; then
	logtty 'Not spawning magic pixel workaround - tint2 executable found. (MicroDesktop active?)'
else
	if grep 'nomagicpixel=2' /proc/cmdline ; then
		while ! ps -C xdotool >/dev/null ; do
			while [ $(xdotool search --name . | wc -l) -lt 3 ] ; do
				sleep 1
			done ;
			logtty 'spawning window foreground monitor (magic-pixel-fix 2).'
			xdotool search --class X2GoAgent behave %@ blur windowmap || xdotool search --class NXAgent behave %@ blur windowmap
			# exit if X11 is no longer running, else sleep for a bit
			ps -C Xorg || exit 0
		done &
	elif grep 'nomagicpixel=1' /proc/cmdline ; then
		logtty 'spawning openbox monitor (magic-pixel-fix 1).'
		while true ; do
			while [ -z "$(xdotool search --class X2GoAgent)" ] && ! ps -C openbox >/dev/null ; do
				openbox &
				logtty 'spawned OpenBox.'
			done
			while [  -n "$(xdotool search --class X2GoAgent)" ] && ps -C openbox >/dev/null ; do
				killall openbox
				logtty 'killed OpenBox.'
			done
			# exit if X11 is no longer running, else sleep for a bit
			ps -C Xorg || exit 0
			sleep 1 # to save cpu cycles
		done &
	else
		: # NOP
	fi
fi
