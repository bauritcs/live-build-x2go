# shellcheck shell=dash
# vim: syntax=sh:

. '/lib/live/config/common.logging'

# configure autostartapps
AUTOSTARTAPPS=$(sed -e 's/ \([^ ]*\)=/\n\1=/g' -e 's/\([^=]["'"'"']\) /\1\n/g' -e 's/ \([^ "'"'"']\)/\n\1/g' /proc/cmdline | awk -F '=' '$1 == "autostartapps" { print $2 }' | tr -dc '0-9a-zA-Z,$-_.+!*'"'"'();/?:@=&|' | tr ',' ' ')
STARTUP_MESSAGE=$(sed -e 's/ \([^ ]*\)=/\n\1=/g' -e 's/\([^=]["'"'"']\) /\1\n/g' /proc/cmdline | awk -F '=' '$1 == "startupmsg" { print $2 }' | tr -d "'\"")
if [ -z "$STARTUP_MESSAGE" ]; then
	STARTUP_MESSAGE="Startup in progress, please wait ..."
fi

# background this and wait for tint2 to appear
(
	xmessage -buttons "" -center "$STARTUP_MESSAGE" &
	XMSG_PID=$!
	logtty "$(printf 'Backgrounding xmessage, PID '"'"'%s'"'" "${XMSG_PID}")"

	while ! xdotool search tint2 >/dev/null; do sleep 1; done

	for APP in $AUTOSTARTAPPS; do
		if [ "$APP" = "x5250" ] ; then
			logtty 'Spawning one or more x5250 sessions.'
			X5250SESSIONLIST=$(grep -A1 "^execp_tooltip = 5250" ~/.config/tint2/tint2rc | awk -F'=' '$1=="execp_lclick_command " {print $2 ","}')
			logtty "$(printf 'Found these x5250 sessions: '"'"'%s'"'" "${X5250SESSIONLIST}")"
			if [ -n "$X5250SESSIONLIST" ]; then
				oldIFS="${IFS}"
				newIFS=','
				IFS="${newIFS}"
				for X5250SESSION in $X5250SESSIONLIST; do
					logtty "$(printf 'Spawning '"'"'%s'"'"'.' "${X5250SESSION}")"
					IFS="${oldIFS}"
					$X5250SESSION &
					xdotool search --sync --onlyvisible --name $(printf '%s\n' "${X5250SESSION}" | awk '{gsub(/^.*\//,""); print $1, $NF}') # x3270/x5250 doesn't support --pid
					IFS="${newIFS}"
				done
				IFS="${oldIFS}"
			else
				# check if we have an x5250 command or if we need to emulate it with x3270
				if [ -x /usr/local/bin/x5250 ] ; then
					logtty 'Spawning '"'"'/usr/local/bin/x5250'"'"'.'
					/usr/local/bin/x5250 &
					xdotool search --sync --onlyvisible --name x5250 # x3270/x5250 doesn't support --pid
				elif [ -x /usr/bin/x5250 ] ; then
					logtty 'Spawning '"'"'/usr/bin/x5250'"'"'.'
					/usr/bin/x5250 &
					xdotool search --sync --onlyvisible --name x5250 # x3270/x5250 doesn't support --pid
				elif [ -x /usr/bin/x3270 ] ; then
					logtty 'Spawning '"'"'/usr/bin/x3270 -model 2'"'"'.'
					/usr/bin/x3270 -model 2 &
					xdotool search --sync --onlyvisible --name x3270 # x3270/x5250 doesn't support --pid
				else
					logtty 'Not spawning any x5250 emulation - no suitable executable found.'
				fi
			fi
		elif [ "$APP" = "x3270" ] ; then
			logtty 'Spawning one or more x3270 sessions.'
			X3270SESSIONLIST=$(grep -A1 "^execp_tooltip = 3270" ~/.config/tint2/tint2rc | awk -F'=' '$1=="execp_lclick_command " {print $2 ","}')
			logtty "$(printf 'Found these x3270 sessions: '"'"'%s'"'" "${X3270SESSIONLIST}")"
			if [ -n "${X3270SESSIONLIST}" ]; then
				oldIFS="${IFS}"
				newIFS=','
				IFS="${newIFS}"
				for X3270SESSION in $X3270SESSIONLIST; do
					logtty "$(printf 'Spawning '"'"'%s'"'"'.' "${X3270SESSION}")"
					IFS="${oldIFS}"
					$X3270SESSION &
					xdotool search --sync --onlyvisible --name $(printf '%s\n' "${X3270SESSION}" | awk '{gsub(/^.*\//,""); print $1, $NF}') # x3270/x5250 doesn't support --pid
					IFS="${newIFS}"
				done
				IFS="${oldIFS}"
			else
				# check if we have an x3270 command
				if [ -x /usr/bin/x3270 ] ; then
					logtty 'Spawning '"'"'/usr/bin/x3270'"'"'.'
					/usr/bin/x3270 &
					xdotool search --sync --onlyvisible --name x3270 # x3270/x5250 doesn't support --pid
				else
					logtty 'Not spawning any x3270 emulation - no suitable executable found.'
				fi
			fi
		else
			APPFULLPATH=$(which "$APP")
			# some *.desktop files have "debian-" prefixed to the name of the actual executable
			# catch this here in case someone specifies the .*desktop file name instead of the app name
			APPFULLPATHSTRIPPED=$(which "${APP#debian-}")
			if [ -n "$APPFULLPATH" ]; then
				logtty "$(printf 'Spawning '"'"'%s'"'"'.' "${APPFULLPATH}")"
				$APPFULLPATH &
				xdotool search --sync --onlyvisible --pid $!
			elif [ -n "$APPFULLPATHSTRIPPED" ]; then
				logtty "$(printf 'Spawning '"'"'%s'"'"'.' "${APPFULLPATHSTRIPPED}")"
				$APPFULLPATHSTRIPPED &
				xdotool search --sync --onlyvisible --pid $!
			fi
		fi
	done
	if ps -p $XMSG_PID >/dev/null ; then
		logtty "$(printf 'Killing xmessage, PID '"'"'%s'"'"' ...' "${XMSG_PID}")"
		if kill -9 $XMSG_PID ; then
			logtty "$(printf 'Killed xmessage, PID '"'"'%s'"'"'.' "${XMSG_PID}")"
		else
			logtty "$(printf 'Could not kill xmessage, PID '"'"'%s'"'"'.' "${XMSG_PID}")"
		fi
	else
		logtty "$(printf 'Could not find a running xmessage instance at PID '"'"'%s'"'"'.' "${XMSG_PID}")"
	fi
) &
logtty 'Done.'
