#!/bin/dash

# shellcheck shell=dash
# vim: syntax=sh:

log_internal() {
	colon="${1}"
	shift

	newline="${2}"
	shift

	printf '\n%s | %s | '"'"'%s'"'"'%s %s' "$(date '+%F')" "$(date '+%T')" "${0}" "${colon}" "${*}"

	if [ '1' = "${newline}" ]; then
		printf '\n'
	fi
}

logtty_internal() {
	log_internal "${@}" | tee -a '/dev/tty8'
}

logtty() {
	logtty_internal '' '0' "${*}"
}

logttynl() {
	logtty_internal '' '1' "${*}"
}

logttycolon() {
	logtty_internal ':' '0' "${*}"
}

logttynlcolon() {
	logtty_internal ':' '1' "${*}"
}

logcon() {
	log_internal '' '0' "${*}"
}

logconnl() {
	log_internal '' '1' "${*}"
}

logconcolon() {
	log_internal ':' '0' "${*}"
}

logconnlcolon() {
	log_internal ':' '1' "${*}"
}
