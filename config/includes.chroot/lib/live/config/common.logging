#!/bin/dash

# shellcheck shell=dash
# vim: syntax=sh:

log_internal() {
	colon="${1}"
	shift

	newline="${2}"
	shift

	preamble="${3}"
	shift

	if [ -n "${preamble}" ] && [ '0' != "${preamble}" ]; then
		printf '\n%s | %s | '"'"'%s'"'" "$(date '+%F')" "$(date '+%T')" "${0}"
	fi

	if [ -n "${colon}" ]; then
		printf ' %s ' "${colon}"
	else
		printf ' '
	fi

	printf '%s' "${*}"

	if [ -n "${newline}" ] && [ '0' != "${newline}" ]; then
		printf '\n'
	fi
}

logtty_internal() {
	log_internal "${@}" | tee -a '/dev/tty8'
}

logtty() {
	logtty_internal '' '0' '1' "${*}"
}

logttynl() {
	logtty_internal '' '1' '1' "${*}"
}

logttycolon() {
	logtty_internal ':' '0' '1' "${*}"
}

logttynlcolon() {
	logtty_internal ':' '1' '1' "${*}"
}

logcon() {
	log_internal '' '0' '1' "${*}"
}

logconnl() {
	log_internal '' '1' '1' "${*}"
}

logconcolon() {
	log_internal ':' '0' '1' "${*}"
}

logconnlcolon() {
	log_internal ':' '1' '1' "${*}"
}
