#!/bin/dash

# shellcheck shell=dash
# vim: syntax=sh:

log_internal() {
	colon="${1}"
	shift

	printf '\n%s | %s | '"'"'%s'"'"'%s %s' "$(date '+%F')" "$(date '+%T')" "${0}" "${colon}" "${*}"
}

logtty_internal() {
	log_internal "${@}" | tee -a '/dev/tty8'
}

logtty() {
	logtty_internal '' "${*}"
}

logttycolon() {
	logtty_internal ':' "${*}"
}

logcon() {
	log_internal '' "${*}"
}

logconcolon() {
	log_internal ':' "${*}"
}
